{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "short_name": "ClamAV Link Guard",
  "description": "__MSG_ext_desc__",
  "version": "__VERSION__",
  "default_locale": "fr",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }, "default_title": "__MSG_ext_name__", "default_popup": "popup.html" },
  "permissions": [ "nativeMessaging", "webNavigation", "tabs", "notifications", "storage" ],
  "host_permissions": [ "http://*/*", "https://*/*" ],
  "key": "__KEY__"
}
