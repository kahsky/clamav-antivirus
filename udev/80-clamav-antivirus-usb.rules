# ClamAV Antivirus — analyse des supports USB avant leur mise à disposition.
# Quand le service clamav-antivirus-daemon tourne (son socket existe), le montage
# automatique par udisks est désactivé pour les périphériques de stockage USB :
# le service monte la clé en privé, l'analyse, puis l'interface la monte pour
# l'utilisateur. Sans le service, le comportement habituel est conservé.
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", TEST=="/run/clamav-antivirus/daemon.sock", ENV{UDISKS_AUTO}="0"
